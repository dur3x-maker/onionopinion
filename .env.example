APP_NAME=OnionOpinion
ENVIRONMENT=development
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Optional override. When empty, Compose builds the PostgreSQL URL from POSTGRES_PASSWORD.
DATABASE_URL=
SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: ALLOWED_HOSTS=onionopinion.my
# Documentation range only; replace with the real private admin network at deployment.
ADMIN_ALLOWED_NETWORKS=
# Configure only the actual reverse-proxy network; never trust all addresses.
TRUSTED_PROXY_NETWORKS=
OFFICIAL_CLEARNET_URL=https://onionopinion.my
# Set only after the real Onion Service exists. Never use a fabricated address.
OFFICIAL_ONION_URL=
AVATAR_STORAGE_DIR=/data/avatars
AVATAR_MAX_BYTES=2097152
APP_PORT=8000
